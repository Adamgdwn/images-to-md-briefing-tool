NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PARSER_URL=http://127.0.0.1:8000
APP_DATA_DIR=../../data

# Optional. Used only when the output generator is configured for Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Local account mode uses Claude Code credentials instead of an Anthropic API key.
ANTHROPIC_AUTH_MODE=claude_code
CLAUDE_CODE_PATH=claude
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_TIMEOUT_SECONDS=180

# OCR provider selection happens inside services/parser.
OCR_PRIMARY_BACKEND=paddleocr
OCR_FALLBACK_BACKEND=tesseract
OCR_MIN_CONFIDENCE=0.45
OCR_PADDLE_LANG=en
